{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/uploads/(.*)", "destination": { "service": "server" } },
    { "source": "/robots.txt", "destination": { "service": "server" } },
    { "source": "/sitemap.xml", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client", "path": "/index.html" } }
  ]
}
